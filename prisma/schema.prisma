// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// NestJS compiles to CommonJS, so the client must be generated as CJS too.
// Without moduleFormat = "cjs" the generated ESM client fails at require() time
// with "exports is not defined in ES module scope".
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  // CJS resolution: extensionless imports work under ts-node, ts-jest and tsc
  // alike. The default (".js") breaks at require() time because the generated
  // files are TypeScript sources, not compiled JS.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================
// ADMIN_MASTER is the platform operator, not a company role. Exactly one exists, it
// lives in the reserved platform tenant, and no API path can assign it -- see
// ASSIGNABLE_ROLES in src/users/assignable-role.ts and the partial unique index in
// the `admin_master_uniqueness` migration.
enum UserRole {
  ADMIN_MASTER
  ADMIN
  AGENT
  REQUESTER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Four levels and no numeric ordering: the code never compares priorities, it
// filters and it sorts by an explicit list. An Int would invite `priority > 2`,
// which silently changes meaning the day a level is inserted in the middle.
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  OTHER
}

// The lifecycle of an asynchronous export. PROCESSING exists so that a worker
// that dies mid-job leaves a row that is visibly stuck rather than one that is
// indistinguishable from a job nobody has picked up yet.
enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// 1. TENANT (the customer company)
// ==========================================
// No @@unique([tenantId, id]) here: Tenant is not tenant-scoped, it *is* the tenant.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  domain    String?  @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Marks the one reserved tenant the ADMIN_MASTER lives in.
  //
  // Nullable-and-unique rather than a plain Boolean, and that is the whole trick:
  // PostgreSQL treats NULLs as distinct in a unique index, so "at most one row with
  // true" falls out of a constraint the schema can express. No partial index, and
  // therefore no drift on `prisma migrate dev`.
  //
  // It also keeps the company listing honest. Every company is `isPlatform: null`,
  // so `where: { isPlatform: null }` is exact -- where `domain: { not: "platform" }`
  // would silently drop every company whose domain is NULL, because
  // NOT (NULL = 'platform') is NULL, not true.
  isPlatform Boolean? @unique @map("is_platform")

  users         User[]
  tickets       Ticket[]
  comments      Comment[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  reports       Report[]

  // Optional and singular: the row is created with the company, but every tenant
  // that predates the ticket_counters table got one by backfill rather than by
  // the schema, so the relation cannot claim it is always there.
  ticketCounter TicketCounter?

  @@map("tenants")
}

// ==========================================
// 2. USER (access control - RBAC)
// ==========================================
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(REQUESTER)
  createdAt    DateTime @default(now()) @map("created_at")

  // SOFT DELETE, and not out of stylistic preference: the FKs from AuditLog and
  // Ticket.assignee are RESTRICT (see the comment on AuditLog), so deleting a
  // user with history fails in the database itself. Deactivating preserves the
  // audit trail and the tickets' links.
  //
  // Consequence: the email keeps occupying @@unique([tenantId, email]), so
  // recreating a user with the same email conflicts. That is why a restore route
  // exists instead of just a fresh create.
  //
  // The `deletedAt: null` filter lives in the service, not in the tenancy
  // extension: the extension is about the tenant, and overloading it would make
  // rows silently vanish from every future model.
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketsCreated  Ticket[]       @relation("TicketRequester")
  ticketsAssigned Ticket[]       @relation("TicketAssignee")
  ticketsClosed   Ticket[]       @relation("TicketClosedBy")
  reports         Report[]
  comments        Comment[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]

  // An email does not repeat within the same company, but may exist in another.
  @@unique([tenantId, email])
  // Gives the extension a guaranteed way to scope findUnique by tenant:
  //   where: { tenantId_id: { tenantId, id } }
  // It also replaces @@index([tenantId]) - a composite unique on (tenant_id, id)
  // is already an index with tenant_id as its leading column.
  @@unique([tenantId, id])
  @@map("users")
}

// ==========================================
// 3. TICKET (core domain)
// ==========================================
model Ticket {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // The number a user says out loud -- "chamado 142" -- and it restarts at 1 in
  // every company, so it is not the id and cannot be one. Generated by taking the
  // row lock on ticket_counters inside the same interactive transaction as the
  // insert: two concurrent opens in one tenant serialize, and neither skips a
  // number nor reuses one.
  number Int

  requesterId String         @map("requester_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  title       String         @db.VarChar(255)
  description String?        @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    TicketCategory @default(OTHER)

  // OPTIMISTIC CONCURRENCY CONTROL.
  // The safe update is updateMany({ where: { id, tenantId, version } }) and not
  // update(): `update` requires a unique where, and { id, version } is not unique.
  // count === 0 means another request already changed the row -> 409 Conflict.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Carried as columns rather than derived from `status`, because a ticket that
  // was resolved, reopened and resolved again has a history that `status` alone
  // cannot express. They are also what any time-to-resolution report reads.
  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id") @db.Uuid

  // Composite FKs against the parent's @@unique([tenantId, id]). This makes
  // Postgres itself reject a reference to another tenant's record, regardless of
  // whether the Prisma extension is correct -- and it removes tenantId from the
  // nested write input, so the wrong tenant stops being expressible in the API.
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester User      @relation("TicketRequester", fields: [tenantId, requesterId], references: [tenantId, id])
  // Restrict and not SetNull: you cannot null out assigneeId alone in a composite
  // key while tenantId is NOT NULL. Reassign before deleting the user.
  assignee  User?     @relation("TicketAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)
  // Restrict for the same reason as assignee, and it is why closing is recorded
  // rather than inferred: whoever closed the ticket has to stay resolvable.
  closedBy  User?     @relation("TicketClosedBy", fields: [tenantId, closedById], references: [tenantId, id], onDelete: Restrict)
  comments  Comment[]

  @@unique([tenantId, id])
  // The per-tenant sequence, enforced by the database and not only by the counter:
  // if the counter logic ever regresses, the second ticket to claim a number fails
  // loudly instead of producing two "chamado 142".
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, requesterId])
  // The default list order is newest first, and without tenant_id leading, the
  // index does not enter the plan for a tenant-scoped query.
  @@index([tenantId, createdAt])
  @@map("tickets")
}

// ==========================================
// 4. COMMENT (the conversation inside a ticket)
// ==========================================
model Comment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body     String @db.Text

  // The agent-only note. A REQUESTER never sees one, and the filter that hides it
  // is applied to the count as well as to the page: a total that included hidden
  // rows would announce that something is being hidden.
  //
  // There is no updatedAt beside it because a comment is append-only. The thread
  // is an audit artefact, and an editable audit artefact is not one.
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  author User   @relation(fields: [tenantId, authorId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, ticketId])
  @@map("comments")
}

// ==========================================
// 5. AUDIT LOG (the audit trail)
// ==========================================
model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  entityType String  @map("entity_type") @db.VarChar(50)
  entityId   String  @map("entity_id") @db.Uuid
  action     String  @db.VarChar(50)

  // Prisma's Json -> JSONB in PostgreSQL.
  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict for the same reason as assignee. Accepted consequence: the audit
  // trail prevents deleting a user with history. The deletion flow has to
  // anonymise first (auditLog.updateMany -> userId: null), and forgetting that
  // fails loudly.
  user   User?  @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  // tenant_id leads: every audit query is tenant-scoped, and without it in front
  // the index does not enter the execution plan.
  @@index([tenantId, entityType, entityId])
  // The tenant-wide feed reads newest first and filters by nothing else, so the
  // entity index above cannot serve it.
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// 6. REFRESH TOKEN (rotation and revocation)
// ==========================================
// Exists so that logging out means something. A purely stateless refresh token
// can only be invalidated by waiting for it to expire; with the row here,
// revoking is an UPDATE.
model RefreshToken {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  // sha256 hex of the presented JWT, always 64 characters. The hash and not the
  // token: a database dump does not become a set of usable sessions.
  //
  // sha256 and not bcrypt on purpose. bcrypt exists for low-entropy,
  // human-chosen secrets; a 256-bit random token gains nothing from a slow KDF
  // and would pay its cost on every rotation.
  //
  // A global @unique is safe: the extension injects tenantId into the
  // findUnique where, so another tenant's token comes back as not-found.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at")
  // Null while valid. Filled in on logout, on rotation and on reuse detection --
  // which revokes the user's entire family at once.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade and not Restrict: the token is not history, and user deletion is soft
  // anyway. A future hard delete should not trip over this.
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  // To revoke a user's entire family in one shot.
  @@index([tenantId, userId])
  @@map("refresh_tokens")
}

// ==========================================
// 7. TICKET COUNTER (the per-tenant sequence)
// ==========================================
// One row per tenant, holding the last ticket number handed out. It exists
// because `SELECT MAX(number) + 1` is a race: two concurrent opens read the same
// maximum and claim the same number.
//
// The increment is `updateManyAndReturn({ where: {}, data: { lastNumber:
// { increment: 1 } } })` run inside the interactive transaction that inserts the
// ticket. Three things make that correct, and each matters:
//   - `increment` compiles to `SET last_number = last_number + 1`, evaluated by
//     PostgreSQL, so no read-then-write happens in Node.
//   - the UPDATE takes a row lock held until the transaction commits, so a second
//     opener in the same tenant waits rather than reading a stale value.
//   - `where: {}` lets the tenancy extension inject the tenant filter. A
//     `findUnique` or an `update` would need the id spelled out, and spelling it
//     out is the hand-written tenant filter this project exists to avoid.
//
// Deliberately no `id` and therefore no @@unique([tenantId, id]), which is the one
// requirement in TENANCY_EXTENSION.md's checklist this model does not meet. That
// requirement exists to give the extension a way to scope findUnique; nothing here
// ever calls findUnique, because the tenant *is* the key.
model TicketCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ticket_counters")
}

// ==========================================
// 8. REPORT (the asynchronous export)
// ==========================================
// The row the API returns with 202 Accepted, and the row a BullMQ worker fills in
// later. It is the whole reason the queue exists: generating a year of tickets as
// CSV inside the request would block the event loop for every other caller.
model Report {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  status        ReportStatus @default(PENDING)

  // The QueryTicketsDto that produced this report, as JSONB. Kept so the row can
  // say what it actually contains -- filters live in the URL, and a URL is gone by
  // the time the file is downloaded.
  filters Json?

  rowCount Int? @map("row_count")

  // The CSV itself, in the database rather than in object storage. MAIN.md calls
  // for S3/MinIO and that remains the right answer; this is the scoped-down
  // version, and REPORTS_MAX_ROWS is what keeps a row from growing without bound.
  content String? @db.Text

  // Filled on FAILED. Null on every other status.
  error String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, like every other user reference that is history: deactivating the
  // requester must not take their reports with them.
  requestedBy User   @relation(fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, requestedById])
  @@map("reports")
}

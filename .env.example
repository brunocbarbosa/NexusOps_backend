# Copy to .env and adjust. `.env` is gitignored; keep this file in sync when adding variables.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (consumed by docker-compose.yml and by DATABASE_URL below) ---
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=nexusops
POSTGRES_DB=nexusops
POSTGRES_PORT=5432

# Read by scripts/initdb/01-app-role.sql, which creates the low-privilege role
# the application connects as. Must match the password inside DATABASE_URL_APP.
# The script runs only at container creation: an existing container picks the
# role up after `npm run infra:reset`, which wipes local data.
POSTGRES_APP_PASSWORD=nexusops_app

# Read by prisma.config.ts (via dotenv) and by the Prisma client at runtime.
DATABASE_URL="postgresql://nexusops:nexusops@localhost:5432/nexusops?schema=public"

# The application's own connection: a NOSUPERUSER NOBYPASSRLS role that does not
# own the tables, so the RLS policies actually apply to it. DATABASE_URL above
# stays the owner and keeps running the migrations. The app refuses to boot if
# the two are equal -- two identical URLs is not a misconfiguration that
# announces itself, it is RLS silently inert.
DATABASE_URL_APP="postgresql://nexusops_app:nexusops_app@localhost:5432/nexusops?schema=public"

# How many database connections the application may hold at once.
#
# This is a ceiling on concurrent *requests*, not on concurrent queries: under
# Row-Level Security a scope is a transaction, and a transaction pins one
# connection for as long as the request that opened it runs. Request number
# POOL_MAX+1 does not fail — it waits, and gives up after 5 seconds if nothing
# frees. Measured: 20 simultaneous scopes settle at exactly this many
# connections.
#
# 10 is fine for one developer. In production the number that matters is this
# times the number of instances, weighed against the server's max_connections.
DATABASE_POOL_MAX=10

# --- Redis (BullMQ queues + permission cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# The ceiling on one CSV export. The report body lives in a TEXT column rather
# than in a bucket, so this is what bounds a single row.
REPORTS_MAX_ROWS=50000

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=15m

# A *different* secret, not the same one with a longer expiry: access and
# refresh tokens carry nearly the same claims, so under one key a refresh token
# is accepted as a bearer token and its 7 days replace the access token's 15
# minutes. The app refuses to boot if the two are equal.
JWT_REFRESH_SECRET=change-me-too-and-not-to-the-same-value
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Platform operator (ADMIN_MASTER) ---
# The single account that creates companies and provisions their users. It is
# seeded into a reserved platform tenant at boot, idempotently: this file is the
# source of truth, so changing the password (or the email) here rotates the
# account on the next start. It logs in like anyone else, with the reserved
# domain: POST /auth/login { "tenantDomain": "platform", ... }
ADMIN_MASTER_EMAIL=admin@nexusops.local
# The app refuses to boot in production while this is still the placeholder.
ADMIN_MASTER_PASSWORD=change-me-before-any-deployment

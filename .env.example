# Copy to .env and adjust. `.env` is gitignored; keep this file in sync when adding variables.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (consumed by docker-compose.yml and by DATABASE_URL below) ---
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=nexusops
POSTGRES_DB=nexusops
POSTGRES_PORT=5432

# Read by prisma.config.ts (via dotenv) and by the Prisma client at runtime.
DATABASE_URL="postgresql://nexusops:nexusops@localhost:5432/nexusops?schema=public"

# Row-Level Security is bypassed by the table owner, so migrations run as the
# owner while the application connects as a non-owner role. Point this at that
# restricted role once the RLS policies and role exist.
# DATABASE_URL_APP="postgresql://nexusops_app:changeme@localhost:5432/nexusops?schema=public"

# --- Redis (BullMQ queues + permission cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Environment for the integration and e2e suites. Committed on purpose: these
# credentials only ever reach the throwaway containers in docker-compose.test.yml,
# and CI needs the same values without a secret round-trip.
#
# Loaded by dotenv through DOTENV_CONFIG_PATH, set by the test:int / test:e2e
# scripts. Nothing reads this file unless that variable points at it, so a
# normal `npm run start:dev` still uses .env.

NODE_ENV=test
PORT=3001

# Ports 5433/6380 belong to docker-compose.test.yml, not to the development
# stack on 5432/6379. Running tests must never touch the development database.
DATABASE_URL="postgresql://nexusops_test:nexusops_test@localhost:5433/nexusops_test?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6380

# Fixed so token fixtures stay reproducible across runs and machines.
JWT_SECRET=test-only-secret-not-used-outside-docker-compose-test
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Lowest legal cost: bcrypt at 12 rounds would dominate the runtime of every
# auth test for no added confidence.
BCRYPT_SALT_ROUNDS=4

# Build context hygiene. Anything listed here either does not belong in an
# image or is regenerated inside the builder stage.

.git
.github
.husky
node_modules
dist
coverage
coverage-integration
coverage-e2e

# Regenerated by `prisma generate` in the builder. Copying a host-generated
# client risks shipping one built against a different schema than prisma/.
src/generated

# Secrets and local-only environment. .env.test is excluded too: the image must
# never carry a configuration that points at a test database.
.env
.env.*

test
documents
docs
.agents
.claude
.windsurf
*.md
!README.md
docker-compose*.yml
